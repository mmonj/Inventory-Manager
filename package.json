{
  "name": "inventory-manager",
  "scripts": {
    "dev": "uv run python manage.py runserver 0.0.0.0:${DJANGO_DEV_PORT:?}",
    "client:typecheck": "tsc --noEmit",
    "client:format": "prettier --write 'client/**/*.ts' 'client/**/*.tsx'",
    "server:check": "uv run python manage.py check",
    "server:typecheck": "uv run mypy .",
    "server:format": "uv run ruff format .",
    "server:lint": "uv run ruff check .",
    "server:lint:fix": "uv run ruff check . --fix",
    "server:generate_types": "uv run python manage.py generate_client_assets",
    "server:build": "uv run python manage.py generate_client_assets && uv run python manage.py build",
    "server:start": "uv run uvicorn server.asgi:application --host 0.0.0.0 --port ${DJANGO_DEPLOY_PORT:?}",
    "server:deploy": "uv run bash -c 'python manage.py migrate && npm run server:build && python manage.py collectstatic --clear --noinput && npm run server:start'"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@react-google-maps/api": "^2.20.8",
    "@tailwindcss/vite": "4.2.2",
    "@types/leaflet": "^1.9.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "6.0.1",
    "bootstrap": "^5.3.0",
    "date-fns": "^2.30.0",
    "eslint": "~9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "express": "^5.0.1",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "motion": "^12.43.0",
    "prettier": "^3.3.3",
    "react": "^19.0.0",
    "react-bootstrap": "^2.8.0",
    "react-day-picker": "^8.10.2",
    "react-dom": "^19.0.0",
    "react-json-view-lite": "^2.5.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.16.0",
    "react-select": "^5.10.2",
    "reactivated": "^0.51.0",
    "sass": "^1.94.0",
    "tailwindcss": "4.2.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.20.0",
    "vite": "8.0.13",
    "zod": "^3.21.4"
  }
}
